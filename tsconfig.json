{
	"compilerOptions": {
		"target": "es6",
		"module": "node16",
		"outDir": "./dist",
		"rootDir": ".",
		"strict": true,
		"isolatedModules": true,
		"paths": {
			"#root/*": ["./*"],
			"#src/*": ["./src/*"],
			"#tempVC/*": ["./src/functions/tempVoiceChannels/*"]
		}
	},
	"include": ["./src"],
	"exclude": ["./node_modules", "./src/**/*.ignore.ts"]
}
